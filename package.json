{
  "name": "detube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Chrome extension that replaces YouTube's personalized home feed with a neutral, user-controlled discovery feed.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "youtube",
    "recommendation-algorithm",
    "feed",
    "discovery",
    "privacy",
    "typescript",
    "esbuild",
    "vitest"
  ],
  "license": "MIT",
  "author": "Dinesh K N",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dineshkn-dev/detube.git"
  },
  "homepage": "https://github.com/dineshkn-dev/detube#readme",
  "bugs": {
    "url": "https://github.com/dineshkn-dev/detube/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
